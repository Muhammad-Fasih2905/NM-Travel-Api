{
  "openapi": "3.0.0",
  "info": {
    "title": "NM Associates & Travels API",
    "version": "1.0.0",
    "description": "Complete API for Travel Packages and Visa Services using Native MongoDB Driver."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development Server"
    },
    {
      "url": "https://your-app.up.railway.app",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Services",
      "description": "Travel Packages and Visa Services"
    }
  ],
  "paths": {
    "/api/services": {
      "get": {
        "tags": ["Services"],
        "summary": "Get all services",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by category"
          },
          {
            "name": "country",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by country"
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Search in title"
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "post": {
        "tags": ["Services"],
        "summary": "Create a new service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "category": { "type": "string" },
                  "price": { "type": "string" },
                  "duration": { "type": "string" },
                  "includes": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "image_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/api/services/{id}": {
      "get": {
        "tags": ["Services"],
        "summary": "Get service by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Success" },
          "404": { "description": "Not found" }
        }
      }
    }
  }
}